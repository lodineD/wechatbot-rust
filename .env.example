# 企业微信智能机器人配置
WECHAT_BOT_ID=your_bot_id_here
WECHAT_BOT_SECRET=your_bot_secret_here
SPECIAL_USER_ID=15771075163

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_SYSTEM_PROMPT="你是一个 helpful 的 AI 助手"

# 定时日报推送（可选）
# 目标群聊的 chatid，留空则不启用定时推送。
# 需在企业微信后台 → 智能机器人 → 获取群的 chatid。

# 可选：日志级别 (trace, debug, info, warn, error)，默认 info
RUST_LOG=info

# 小红书搜索（可选）
# 启用后 DeepSeek 可以使用 xhs_search 和 xhs_note_detail 工具搜索小红书图文内容。
XHS_ENABLED=true
# 注意：Cookie 不从 .env 读取（太长会破坏 dotenvy 解析），而是从项目根目录的
#       xhs_cookie.txt 文件读取。从浏览器开发者工具 → Application → Cookies
#       复制完整 Cookie 字符串到 xhs_cookie.txt（单行）。有效期约 30 天，
#       过期后重新导出替换即可。Docker 部署时通过 docker-compose.yml 的
#       volumes 自动挂载。
# 搜索实现：使用 camoufox（反指纹 Firefox）绕过小红书风控检测。
#       Docker/Linux 部署时自动满足（feature = "xhs-camoufox" + CAMOUFOX_BIN=/opt/camoufox）。
# 可选：camoufox 二进制路径（Docker 内默认 /opt/camoufox）。
# CAMOUFOX_BIN=/opt/camoufox
