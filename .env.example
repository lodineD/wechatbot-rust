# 企业微信智能机器人配置
WECHAT_BOT_ID=your_bot_id_here
WECHAT_BOT_SECRET=your_bot_secret_here

# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_SYSTEM_PROMPT="你是一个 helpful 的 AI 助手"

# 定时日报推送（可选）
# 目标群聊的 chatid，留空则不启用定时推送。
# 需在企业微信后台 → 智能机器人 → 获取群的 chatid。
DAILY_NEWS_CHAT_ID=

# 可选：日志级别 (trace, debug, info, warn, error)，默认 info
RUST_LOG=info

# 可选：启用 Obscura headless 浏览器作为抓取 fallback。
# 当普通抓取失败或命中反爬页面时，会通过 CDP 调用 Obscura 重新抓取。
# OBSCURA_ENABLED=true
# 可选：Obscura 抓取策略：always（始终用） / fallback（普通失败再用，默认） / never（不用）。
# OBSCURA_FETCH_MODE=fallback
# 可选：Obscura CDP 服务器地址。
# - 本地独立运行 Obscura 时保持默认值 http://127.0.0.1:9222。
# - 使用项目自带的 docker-compose.yml 时，compose 文件会覆盖为 http://obscura:9222，无需修改此处。
# OBSCURA_CDP_URL=http://127.0.0.1:9222
